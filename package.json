{
    "name": "avatar-history",
    "version": "0.0.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "start": "turbo run start",
        "deploy": "yarn db push && turbo run start --only",
        "dev": "turbo run dev --parallel",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "db": "yarn workspace @avatar-history/db"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "eslint-config-custom": "*",
        "prettier": "latest"
    },
    "engines": {
        "npm": ">=7.0.0",
        "node": ">=26.0.0"
    },
    "dependencies": {
        "turbo": "latest"
    },
    "packageManager": "yarn@1.22.19"
}
