// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model DiscordUser {
  id       String     @id @unique
  Avatar   Avatar[]
  Username Username[]
}

model Avatar {
  id        String      @id @unique
  createdAt DateTime    @default(now())
  user      DiscordUser @relation(fields: [userId], references: [id])
  userId    String
  // soft delete: hidden from the website and the bot, but kept on disk and in the db
  deletedAt DateTime?
  deletedBy String?

  @@index([userId])
}

model Username {
  id        Int         @id @unique @default(autoincrement())
  createdAt DateTime    @default(now())
  value     String
  user      DiscordUser @relation(fields: [userId], references: [id])
  userId    String

  @@index([userId])
}

// Discord ids with access to the admin panel. The super admin is hardcoded (see src/entities/admin.ts)
model Admin {
  discordId String   @id
  createdAt DateTime @default(now())
  grantedBy String
}

// Public link to a user's Wrapped of one year (/w/<id>). Opt-in, deleting the row revokes it.
model WrappedShare {
  id        String   @id
  userId    String
  year      Int
  createdAt DateTime @default(now())

  @@unique([userId, year])
}

// Public link to a user's whole profile (/u/<id>). Opt-in, deleting the row revokes it.
model ProfileShare {
  id        String   @id
  userId    String   @unique
  createdAt DateTime @default(now())
}

// One row per run of the update loop, for the health page of the admin panel.
// Only the last few days are kept (see src/entities/update-run.ts).
model UpdateRun {
  id              Int      @id @default(autoincrement())
  startedAt       DateTime
  durationMs      Int
  members         Int      @default(0)
  newAvatars      Int      @default(0)
  newUsernames    Int      @default(0)
  failedDownloads Int      @default(0)
  // set when the run failed; the counts are then what was done until then
  error           String?

  @@index([startedAt])
}

//next-auth

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
